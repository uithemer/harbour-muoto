<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!--
    Polkit actions for sailfishos-uithemer-helperd.

    Defaults policy:
      - allow_active   = yes              (local foregrounded session:
                                           silent, no prompt)
      - allow_inactive = auth_admin_keep  (local but backgrounded:
                                           prompt once, ~5min cache)
      - allow_any      = auth_admin_keep  (everything else, e.g. SSH:
                                           prompt once, ~5min cache)

    Rationale: on a single-user phone the GUI runs in the active
    session, so privileged ops (apply icons, restore, uninstall pack,
    toggle autoupdate) should not interrupt the user with a device-
    password prompt. Remote / inactive sessions still hit the prompt
    so a stray ssh-as-defaultuser cannot drive the daemon silently.

    Transport-layer gate is unchanged: the bus policy in
    /etc/dbus-1/system.d/org.uithemer.UiThemer1.conf only allows
    root and defaultuser to send to the well-known name, regardless
    of polkit decisions here.

    Lipstick on Sailfish OS already runs an authentication agent;
    no extra runtime piece is needed beyond polkit + polkit-qt-core-1.
-->
<policyconfig>
  <vendor>UI Themer</vendor>
  <vendor_url>https://github.com/uithemer/sailfishos-uithemer</vendor_url>

  <action id="org.uithemer.manage-themes">
    <description>Apply, restore or recover UI themes (icons, density)</description>
    <message>Authentication is required to change UI themes.</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.uithemer.manage-packs">
    <description>Uninstall theme packs</description>
    <message>Authentication is required to uninstall a theme pack.</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.uithemer.manage-system-services">
    <description>Manage UI Themer system services and helper apps</description>
    <message>Authentication is required to change UI Themer services.</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
