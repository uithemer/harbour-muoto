[Unit]
Description=Re-apply Muoto icon theme after boot
Documentation=https://github.com/uithemer/harbour-muoto
After=dbus.service apkd.service appsupport@defaultuser.service home.mount
Wants=apkd.service
ConditionPathExists=!/run/defaultuser/osupdate_running
RequiresMountsFor=/home

[Service]
Type=oneshot
# Run as root: waits on icon-ops.lock (flock) while helperd runs ApplyIcons; dconf via su defaultuser.
TimeoutStartSec=600
ExecStart=/usr/bin/harbour-muoto-update-icons

[Install]
WantedBy=multi-user.target
