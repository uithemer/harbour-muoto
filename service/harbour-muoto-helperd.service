[Unit]
Description=Sailfish OS Muoto privileged helper
Documentation=https://github.com/uithemer/harbour-muoto
Requires=dbus.service
After=dbus.service

[Service]
Type=dbus
BusName=org.muoto.Muoto1
User=root
ExecStart=/usr/libexec/harbour-muoto-helperd
# On-demand: D-Bus activation starts the daemon; idle-quit exits after 30s.
Restart=no

# Hardening: writes to /usr/share/icons, /usr/share/harbour-muoto/backup/,
# ~/.local/share/apkd-bridge (chown), and /etc/dconf/db/vendor.d/locks/
# (DensityEnable). ProtectSystem=strict would break those paths.
NoNewPrivileges=yes
ProtectHome=no
PrivateTmp=no
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
