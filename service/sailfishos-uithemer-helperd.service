[Unit]
Description=Sailfish OS UI Themer privileged helper (D-Bus activated)
Documentation=https://github.com/uithemer/sailfishos-uithemer
# The unit is bus-activated; we still hint at network ordering for the
# rare case where polkit / dconf paths need DNS at first auth prompt.
After=dbus.service polkit.service

[Service]
Type=dbus
BusName=org.uithemer.UiThemer1
ExecStart=/usr/libexec/sailfishos-uithemer-helperd --bus
# The daemon self-quits after 30 s idle so it does not pin RAM.
Restart=on-failure
RestartSec=2

# Hardening: the daemon legitimately writes to /usr/share/applications/
# (Icon= rewrites), /usr/share/sailfishos-uithemer/backup/, /etc/systemd/
# system/ (autoupdate timer rewrites) and /etc/dconf/db/vendor.d/locks/
# (DensityEnable). ProtectSystem=strict would break all of those, so we
# keep it off and lean on the smaller set of restrictions below.
NoNewPrivileges=yes
ProtectHome=no
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
# bus-activated, but we keep an alias so service-list tools see it.
WantedBy=multi-user.target
