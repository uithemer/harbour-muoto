<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
                      "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
    org.uithemer.UiThemer1.SystemServices
    -------------------------------------
    Privileged management of the package's own system-wide systemd units
    (autoupdate timer + service, systemupgrade service) and a few small
    file-system tweaks (hide the legacy launcher icon, rewrite the
    autoupdate timer schedule). Gated by the "manage-system-services"
    polkit action.
-->
<node>
  <interface name="org.uithemer.UiThemer1.SystemServices">
    <method name="HideIcon"/>
    <method name="SetAutoupdate">
      <arg name="enabled" direction="in" type="b"/>
    </method>
    <method name="SetServiceSu">
      <arg name="enabled" direction="in" type="b"/>
    </method>
    <method name="ApplyHours">
      <arg name="hours" direction="in" type="s"/>
    </method>
    <signal name="OperationCompleted">
      <arg name="op" type="s"/>
      <arg name="ok" type="b"/>
      <arg name="message" type="s"/>
    </signal>
  </interface>
</node>
