<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
                      "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
    org.muoto.Muoto1.Packs
    ----------------------------
    Privileged theme-pack operations (currently just RPM uninstall).
    Authorization is the system-bus policy in org.muoto.Muoto1.conf.
-->
<node>
  <interface name="org.muoto.Muoto1.Packs">
    <method name="UninstallPack">
      <arg name="rpmName" direction="in" type="s"/>
    </method>
    <signal name="OperationCompleted">
      <arg name="op" type="s"/>
      <arg name="ok" type="b"/>
      <arg name="message" type="s"/>
    </signal>
  </interface>
</node>
